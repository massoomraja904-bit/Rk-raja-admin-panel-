* {
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    margin: 0;
    padding: 20px;
    min-height: 100vh;
    background: #000;
    color: #fff;
    font-family: "Courier New", monospace;
    text-align: center;
}

/* Main Container */
.container {
    width: 100%;
    max-width: 700px;
    margin: 0 auto;
}

/* Heading */
h1 {
    margin: 15px 0 8px;
    font-size: 30px;
    color: #ff00ff;
    text-shadow:
        0 0 5px #ff00ff,
        0 0 15px #ff00ff,
        0 0 30px #ff00ff;
}

h2 {
    margin-bottom: 25px;
    font-size: 20px;
    color: #fff;
}

/* Menu Box */
.button-box {
    max-width: 90%;
    margin: 15px auto;
    padding: 20px;
    background: #000;
    border: 2px solid #00ffff;
    border-radius: 10px;
    box-shadow: 0 0 15px #00ffff;
    transition: 0.3s;
}

.button-box:hover {
    transform: scale(1.02);
    box-shadow:
        0 0 10px #00ffff,
        0 0 25px #00ffff;
}

/* Menu Button */
.button-box a {
    display: block;
    width: 100%;
    padding: 12px 15px;
    background: #00ffff;
    color: #000;
    border-radius: 6px;
    font-size: 15px;
    font-weight: bold;
    text-decoration: none;
    transition: 0.3s;
}

.button-box a:hover {
    background: #fff;
    box-shadow: 0 0 15px #00ffff;
}

/* Cards */
.card {
    margin: 25px auto;
    padding: 25px 20px;
    background: #050505;
    border: 2px solid #00ffff;
    border-radius: 12px;
    color: #00ffff;
    box-shadow: 0 0 15px #00ffff;
}

.card h2 {
    color: #00ffff;
}

/* Admin */
.admin-link,
.admin-box {
    max-width: 90%;
    margin: 25px auto;
}

.admin-link a,
.admin-box a {
    display: block;
    padding: 13px;
    background: #ff00ff;
    color: #000;
    border-radius: 8px;
    font-weight: bold;
    text-decoration: none;
    box-shadow: 0 0 15px #ff00ff;
}

.admin-link a:hover,
.admin-box a:hover {
    background: #fff;
    box-shadow: 0 0 20px #ff00ff;
}

/* Back Button */
.back-btn {
    display: block;
    width: 90%;
    max-width: 500px;
    margin: 25px auto;
    padding: 13px;
    background: #00ffff;
    color: #000;
    border-radius: 7px;
    font-weight: bold;
    text-decoration: none;
    box-shadow: 0 0 12px #00ffff;
}

.back-btn:hover {
    background: #fff;
}

/* Status */
.status {
    display: inline-block;
    margin: 15px 0;
    padding: 10px 20px;
    border: 1px solid #00ff00;
    border-radius: 6px;
    color: #00ff00;
    box-shadow: 0 0 10px #00ff00;
    font-weight: bold;
}

/* Horizontal Line */
.line {
    width: 90%;
    height: 2px;
    margin: 20px auto;
    background: #00ffff;
    box-shadow: 0 0 12px #00ffff;
}

/* Footer */
footer {
    margin-top: 40px;
    padding-bottom: 20px;
    color: #777;
    font-size: 12px;
}

footer a {
    color: #00ffff;
    text-decoration: none;
}

/* Mobile */
@media (max-width: 500px) {

    body {
        padding: 15px;
    }

    h1 {
        font-size: 24px;
    }

    h2 {
        font-size: 17px;
    }

    .button-box {
        padding: 15px;
    }

    .button-box a {
        font-size: 13px;
        padding: 11px;
    }

    .card {
        padding: 20px 12px;
    }
}
